# 复制为 .env 后填写，勿提交真实密钥（.env 已被 .gitignore 忽略）

# DeepSeek 官网 API key
DEEPSEEK_API_KEY=sk-xxx

# 模型路由（任务 -> 别名）
# 开发档默认全 v4pro。上线切 prod：MODEL_AGENT / MODEL_MULTIMODAL 改为 deepseekv4flash，
# MODEL_GEN 保持 deepseekv4pro。只改这里，代码零改动。
MODEL_AGENT=deepseekv4pro
MODEL_MULTIMODAL=deepseekv4pro
MODEL_GEN=deepseekv4pro
ENV=dev

# 别名 -> DeepSeek 官方 model id（官方 id 带连字符）。
# 各账号入口若模型标识不同，在这里覆盖；不填则用右侧默认值。
MODEL_ID_DEEPSEEKV4PRO=deepseek-v4-pro
MODEL_ID_DEEPSEEKV4FLASH=deepseek-v4-flash
# 多模态（上线期）：如需独立视觉模型，把 MODEL_MULTIMODAL=deepseekv4flashvision
# 并取消下行注释即可
# MODEL_ID_DEEPSEEKV4FLASHVISION=deepseek-v4-flash-vision-exp

# JWT（Java/Python 共用，HS256）
JWT_SECRET=please-change-me

# 中间件地址（服务在 WSL2 内时用 127.0.0.1 或容器名）
REDIS_ADDR=127.0.0.1:6379
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=resv
MYSQL_USER=resv
MYSQL_PASSWORD=resv123

# 本地 embedding（vLLM，可选）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.5B
EMBEDDING_MAX_LEN=2048
EMBED_BASE=http://127.0.0.1:8001
